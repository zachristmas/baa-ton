{
  "version": 2,
  "herdr": "herdr",
  "stateDir": "/absolute/path/to/project/.baa-ton/state",
  "maxActive": 4,
  "scopes": {
    "personal": {
      "cwd": "/absolute/path/to/project",
      "workspace": "INSPECTED_WORKSPACE_ID"
    },
    "work": {
      "cwd": "/absolute/path/to/work-project",
      "workspace": "INSPECTED_WORK_WORKSPACE_ID"
    }
  },
  "profiles": {
    "planning": {
      "harness": "claude",
      "model": "claude-opus-5-5",
      "effort": "xhigh",
      "auth": "existing"
    },
    "quick": {
      "harness": "claude",
      "model": "claude-sonnet-5-5",
      "effort": "low",
      "auth": "existing"
    },
    "balanced": {
      "harness": "claude",
      "model": "claude-sonnet-5-5",
      "effort": "medium",
      "auth": "existing"
    },
    "implementation": {
      "harness": "claude",
      "model": "claude-sonnet-5-5",
      "effort": "high",
      "auth": "existing"
    },
    "sustained": {
      "harness": "claude",
      "model": "claude-sonnet-5-5",
      "effort": "medium",
      "auth": "existing"
    },
    "review": {
      "harness": "claude",
      "model": "claude-opus-5-5",
      "effort": "medium",
      "auth": "existing"
    },
    "deep-review": {
      "harness": "claude",
      "model": "claude-fable-5-1",
      "effort": "xhigh",
      "auth": "existing"
    }
  },
  "approvals": {
    "ask": [
      "herdr_connect",
      "herdr_reconnect",
      "herdr_approve"
    ]
  }
}
