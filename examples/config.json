{
  "version": 2,
  "herdr": "herdr",
  "stateDir": "/absolute/path/to/project/.baa-ton/state",
  "maxActive": 4,
  "scopes": {
    "personal": {
      "cwd": "/absolute/path/to/project",
      "workspace": "INSPECTED_WORKSPACE_ID"
    },
    "work": {
      "cwd": "/absolute/path/to/work-project",
      "workspace": "INSPECTED_WORK_WORKSPACE_ID"
    }
  },
  "profiles": {
    "planning": { "harness": "claude", "model": "YOUR_EXACT_MODEL_ID", "effort": "xhigh", "auth": "existing" },
    "implementation": { "harness": "claude", "model": "YOUR_EXACT_MODEL_ID", "effort": "high", "auth": "existing" },
    "deep-review": { "harness": "claude", "model": "YOUR_EXACT_MODEL_ID", "effort": "xhigh", "auth": "existing" }
  },
  "approvals": {
    "ask": [
      "herdr_connect",
      "herdr_reconnect",
      "herdr_approve"
    ]
  }
}
