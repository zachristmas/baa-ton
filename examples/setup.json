{
  "version": 2,
  "projectRoot": "/absolute/path/to/project",
  "harnesses": ["codex"],
  "connect": true,
  "config": {
    "version": 2,
    "herdr": "herdr",
    "maxActive": 4,
    "scopes": {
      "personal": { "cwd": "/absolute/path/to/project", "workspace": "INSPECTED_WORKSPACE_ID" }
    },
    "profiles": {
      "planning": { "harness": "claude", "model": "YOUR_EXACT_CLAUDE_ID", "effort": "high", "auth": "existing" },
      "implementation": { "harness": "claude", "model": "YOUR_EXACT_CLAUDE_ID", "effort": "high", "auth": "existing" },
      "deep-review": { "harness": "claude", "model": "YOUR_EXACT_CLAUDE_ID", "effort": "xhigh", "auth": "existing" }
    },
    "approvals": { "ask": ["herdr_connect", "herdr_reconnect", "herdr_approve"] }
  }
}
